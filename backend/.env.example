# Copy this file to backend/.env and enter your own OpenAI API key.
# Keep backend/.env private; never commit it.
OPENAI_API_KEY=
VOICE_TRANSCRIPTION_URL=http://host.docker.internal:8765/transcribe

# Direct LLM recommendation is the only recommendation path.
LLM_RECOMMENDATION_MODEL=gpt-5.4-mini-2026-03-17
# Optional evidence override, e.g. /common/menu_evidence.json in Docker.
# LLM_MENU_EVIDENCE_FILE=/common/menu_evidence.json
