# Default: real menu lookup and development-only orders.
VITE_MENU_API_MODE=http
VITE_ORDER_API_MODE=mock
# Legacy VITE_API_MODE=mock|http sets both unless overridden above.
# success | empty | menu-error | order-rejected | order-uncertain
VITE_MOCK_SCENARIO=success
# Local Vite proxy target. Docker Compose supplies http://backend:8000.
API_PROXY_TARGET=http://127.0.0.1:8000
